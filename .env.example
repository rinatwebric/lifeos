# LifeOS — frontend environment variables
# Copy this file to `.env.local` and fill in the values from your Supabase project
# (Project Settings -> API).
#
# The anon key is safe to expose in the browser ONLY because every table is
# protected by Row Level Security. Never put the service_role key here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key