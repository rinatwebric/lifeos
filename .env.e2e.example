# Copy this file to `.env.e2e` (gitignored). Playwright e2e tests read it.
#
# The account must exist and be confirmed in Supabase → Authentication → Users.
# Either create it there with "Auto confirm user" checked, or sign up through
# /sign-up and press "Confirm email" on the user afterwards.
#
# Never commit `.env.e2e` with real values.

E2E_EMAIL=e2e.lifeos@gmail.com
E2E_PASSWORD=change-me

# Second isolated account for the two-user RLS test (habits.spec.ts).
# Provision once: E2E_EMAIL_B=... E2E_PASSWORD_B=... node scripts/provision-e2e-user-b.mjs
# (needs SUPABASE_URL + SUPABASE_ANON_KEY in env). With Confirm email OFF the
# sign-up sends no email and returns a session immediately.
# E2E_EMAIL_B=e2e.lifeos+habitsB@gmail.com
# E2E_PASSWORD_B=use-alphanumeric-only-shell-eats-$

# Real inbox for the live sign-up test (iteration 3: Confirm email = OFF,
# sign-up returns a session, no check-email screen). Use a `+`-alias of a
# real mailbox so Supabase never sends to a nonexistent address (fake
# `e2e.signup.*@gmail.com` senders got the default SMTP restricted).
# Absent -> the sign-up test skips, the rest of the suite stays green.
# E2E_SIGNUP_EMAIL=e2e.lifeos+signup@gmail.com

# Read-only RLS probe in planner.spec.ts (iteration 4): the same values as
# `.env.local` (anon key only, never service_role). Absent -> that one test
# skips, the UI tests are unaffected.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-anon-key