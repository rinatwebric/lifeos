# Copy this file to `.env.e2e` (gitignored). Playwright e2e tests read it.
#
# The account must exist and be confirmed in Supabase → Authentication → Users.
# Either create it there with "Auto confirm user" checked, or sign up through
# /sign-up and press "Confirm email" on the user afterwards.
#
# Never commit `.env.e2e` with real values.

E2E_EMAIL=e2e.lifeos@gmail.com
E2E_PASSWORD=change-me